{
  "kind": "capability_smoke_not_formal_cell",
  "row": {
    "condition": "C",
    "main_model": "gpt-6.1-sol",
    "subagent_model": "gpt-6.1-sol",
    "main_effort": "medium",
    "subagent_effort": "medium",
    "timeout_seconds": 90,
    "max_subagents": 1,
    "subagents_enabled": true,
    "installed_role_names": [
      "ui_researcher",
      "ui_integrator",
      "ui_challenger",
      "ui_experience_observer"
    ],
    "transport": "app-server",
    "profile_mode": "inherited",
    "session_persistence": "ephemeral",
    "network_access": true
  },
  "command": [
    "/opt/codex/bin/codex",
    "app-server",
    "--stdio",
    "--enable",
    "multi_agent",
    "-c",
    "agents.enabled=true",
    "-c",
    "agents.max_concurrent_threads_per_session=1",
    "-c",
    "agents.default_subagent_model=\"gpt-6.1-sol\"",
    "-c",
    "agents.default_subagent_reasoning_effort=\"medium\"",
    "-c",
    "model_reasoning_effort=\"medium\"",
    "-c",
    "sandbox_workspace_write.network_access=true",
    "-c",
    "approval_policy=\"on-request\"",
    "-c",
    "approvals_reviewer=\"auto_review\"",
    "-c",
    "features.multi_agent=true",
    "-c",
    "agents.ui_researcher.config_file=\"/workspace/v120-cloud/smoke/project/.codex/agents/ui_researcher.toml\"",
    "-c",
    "agents.ui_researcher.description=\"Deep, independent UI visual researcher. Delegated for high-value resource discovery, actual visual inspection, iterative comparison and curated evidence for the main agent.\"",
    "-c",
    "agents.ui_integrator.config_file=\"/workspace/v120-cloud/smoke/project/.codex/agents/ui_integrator.toml\"",
    "-c",
    "agents.ui_integrator.description=\"Scoped mature-UI integrator for an already selected design/resource and clearly bounded project changes; preserves source craft and verifies actual behavior.\"",
    "-c",
    "agents.ui_challenger.config_file=\"/workspace/v120-cloud/smoke/project/.codex/agents/ui_challenger.toml\"",
    "-c",
    "agents.ui_challenger.description=\"Independent, evidence-based challenger for high-impact UI resource selections and possible premature convergence.\"",
    "-c",
    "agents.ui_experience_observer.config_file=\"/workspace/v120-cloud/smoke/project/.codex/agents/ui_experience_observer.toml\"",
    "-c",
    "agents.ui_experience_observer.description=\"Specialist for complex browser or native-GUI experience investigation, reproducing interaction episodes and returning inspectable visual evidence.\"",
    "-c",
    "sqlite_home=\"/workspace/v120-cloud/smoke/runtime/state\"",
    "-c",
    "log_dir=\"/workspace/v120-cloud/smoke/runtime/logs\""
  ]
}